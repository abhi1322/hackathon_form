# Atlas example (replace USER, PASS, and CLUSTER):
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.example.mongodb.net/hackathon-form?retryWrites=true&w=majority
#
# Local example (requires replica set for transactions):
# MONGODB_URI=mongodb://127.0.0.1:27017/hackathon-form?replicaSet=rs0
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.example.mongodb.net/hackathon-form?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
